{
  "name": "ffmpeg-rest",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "bun --hot apps/api/src/index.ts",
    "dev:worker": "bun --watch apps/worker/src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:all": "bun run lint && bun run typecheck && bun run lint:md",
    "docker:check": "docker build -t ffmpeg-rest:check .",
    "predeploy": "bun run lint && bun run typecheck && bun test && bun run docker:check",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.13",
    "markdownlint-cli2": "^0.15.0",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.6.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint:fix && bun run typecheck"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}

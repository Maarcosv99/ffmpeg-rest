NODE_ENV=development
PORT=3000

REDIS_URL=redis://localhost:6379

# Cloudflare R2 example. For real S3, use the regional endpoint.
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=ffmpeg-rest-dev
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_PUBLIC_URL=https://pub-<hash>.r2.dev/ffmpeg-rest-dev
S3_REGION=auto
# Optional prefix prepended to every output key. Use it together with a
# bucket lifecycle rule (R2 → Lifecycle rules) to auto-expire converted
# files. Leave empty to write to the bucket root.
S3_KEY_PREFIX=outputs/

MAX_INPUT_BYTES=100000000
JOB_CONCURRENCY=2
WEBHOOK_CONCURRENCY=10

# Set to "true" for local testing of webhooks against http://localhost.
ALLOW_HTTP_WEBHOOKS=true

FFMPEG_TIMEOUT_MS=300000
